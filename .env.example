# ─── Vibecoded Orchestrator — Environment Variables ───────────────────────────

# LLM API (Anthropic Claude — used if you wire in the llm.ts tool)
ANTHROPIC_API_KEY=sk-ant-...

# Artifact storage (optional — defaults to local ./runs/artifacts)
ARTIFACT_STORE=local
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1

# Logging
LOG_LEVEL=summary   # none | summary | detailed

# Project defaults (override per session in config/project-sessions/)
DEFAULT_STACK=nextjs
DEFAULT_REGION=IN

# ─── TaskFlow Web App ────────────────────────────────────────────────────────

# NextAuth v5 Configuration
NEXTAUTH_URL=http://localhost:1000
AUTH_SECRET=your-auth-secret-here

# Database Configuration
DATABASE_URL="file:./prisma/dev.db"

# Authentication Providers (Optional - Demo works without these)
GITHUB_ID=your-github-oauth-id
GITHUB_SECRET=your-github-oauth-secret
GOOGLE_CLIENT_ID=your-google-oauth-id
GOOGLE_CLIENT_SECRET=your-google-oauth-secret

# Application Configuration
NODE_ENV=development
APP_NAME="TaskFlow"
APP_URL=http://localhost:1000

# ─── Multi-Model LLM Providers (optional) ──────────────────────────────────

# OpenAI (uncomment to enable — provider auto-discovers latest models)
# OPENAI_API_KEY=sk-...

# Google Gemini (uncomment to enable)
# GOOGLE_API_KEY=AIza...
# GEMINI_API_KEY=AIza...       # alias — either works

# AWS Bedrock (uncomment to enable)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=...        # optional — for temporary credentials

# ─── Notifications (optional) ──────────────────────────────────────────────

# Slack — create an incoming webhook at https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Discord — create a webhook in channel settings → Integrations → Webhooks
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Telegram — create a bot via @BotFather, get chat ID via @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-100...
