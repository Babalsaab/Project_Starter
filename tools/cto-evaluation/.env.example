# =============================================================================
# CTO Evaluation Suite - Environment Configuration
# =============================================================================
# Copy this file to .env and customize as needed.
# These variables are OPTIONAL - the suite works without them.
# =============================================================================

# -----------------------------------------------------------------------------
# Output Configuration
# -----------------------------------------------------------------------------
# Default output directory for evaluation results (default: ./output)
# CTO_OUTPUT_DIR=./output

# Default output format: json, markdown, html, or all (default: all)
# CTO_OUTPUT_FORMAT=all

# -----------------------------------------------------------------------------
# Execution Options
# -----------------------------------------------------------------------------
# Enable verbose logging (default: false)
# CTO_VERBOSE=false

# Run in quick mode with fewer checks (default: false)
# CTO_QUICK_MODE=false

# Maximum parallel processes for evaluation (default: 4)
# CTO_MAX_PARALLEL=4

# Timeout for individual evaluation scripts in seconds (default: 300)
# CTO_SCRIPT_TIMEOUT=300

# -----------------------------------------------------------------------------
# Skip Options
# -----------------------------------------------------------------------------
# Skip security scanning (default: false)
# CTO_SKIP_SECURITY=false

# Skip performance testing (default: false)
# CTO_SKIP_PERFORMANCE=false

# Skip mobile evaluation (default: false)
# CTO_SKIP_MOBILE=false

# -----------------------------------------------------------------------------
# External Tool Configurations
# -----------------------------------------------------------------------------
# SonarQube server URL (optional - for enhanced code analysis)
# SONARQUBE_URL=http://localhost:9000
# SONARQUBE_TOKEN=

# Lighthouse configuration (optional - for web performance)
# LIGHTHOUSE_CHROME_FLAGS="--headless --disable-gpu"

# Semgrep configuration
# SEMGREP_RULES_DIR=./tools/security

# -----------------------------------------------------------------------------
# Thresholds (Override config/thresholds.yaml)
# -----------------------------------------------------------------------------
# Minimum passing score (default: 6.0)
# CTO_MIN_PASSING_SCORE=6.0

# Security vulnerability thresholds
# CTO_MAX_CRITICAL_VULNS=0
# CTO_MAX_HIGH_VULNS=5

# Test coverage minimum (percentage)
# CTO_MIN_TEST_COVERAGE=70

# -----------------------------------------------------------------------------
# Report Configuration
# -----------------------------------------------------------------------------
# Company name for report headers (optional)
# CTO_COMPANY_NAME=

# Include detailed findings in report (default: true)
# CTO_DETAILED_FINDINGS=true

# Include recommendations in report (default: true)
# CTO_INCLUDE_RECOMMENDATIONS=true

# -----------------------------------------------------------------------------
# Integration Tokens (Optional - for enhanced analysis)
# -----------------------------------------------------------------------------
# GitHub token for repository analysis
# GITHUB_TOKEN=

# GitLab token for repository analysis
# GITLAB_TOKEN=

# Snyk token for dependency scanning
# SNYK_TOKEN=

# Note: Never commit actual tokens. Use a secrets manager or
# environment variables set outside this file in production.
