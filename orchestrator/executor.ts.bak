/**
 * Agent Execution Engine
 *
 * Takes a project session and actually executes each agent by calling
 * Claude API with the agent's system_prompt, passing relevant context,
 * and collecting outputs into runs/artifacts/<project-id>/.
 *
 * Supports sequential and parallel execution based on task dependencies.
 */

/// <reference types="node" />
import * as fs from "fs";
import * as path from "path";
import * as yaml from "js-yaml";
import {
  AgentConfig,
  ProjectSession,
  loadAgentFromPool,
  updateSessionStatus,
} from "./agent-configurator";

// ─── Types ────────────────────────────────────────────────────────────────────

export interface TaskStep {
  id: string;
  label: string;
  owner_agent: string;
  status: "pending" | "in_progress" | "done" | "failed" | "skipped";
  priority: "low" | "medium" | "high";
  depends_on: string[];
  inputs: {
    from_sections: string[];
    from_artifacts: string[];
  };
  outputs: {
    artifact_id: string;
    summary: string;
  };
  token_cap: number;
  started_at?: string;
  completed_at?: string;
  error?: string;
}

export interface ExecutionPlan {
  project_id: string;
  created_at: string;
  steps: TaskStep[];
  current_step: number;
  status: "pending" | "running" | "completed" | "failed" | "paused";
}

export interface ArtifactMeta {
  id: string;
  agent_id: string;
  type: "markdown" | "code" | "json" | "yaml";
  filename: string;
  summary: string;
  created_at: string;
  token_count: number;
}

export interface ExecutionResult {
  plan: ExecutionPlan;
  artifacts: ArtifactMeta[];
  total_tokens_used: number;
  duration_ms: number;
}

// ─── Mentors Config ───────────────────────────────────────────────────────────

interface MentorDef {
  name: string;
  domain_focus: string;
  quote: string;
  principles: string[];
  influences_agents: string[];
  review_lens: string;
}

interface ReviewPassEntry {
  mentor: string;
  focus: string;
  question: string;
}

interface MentorsConfig {
  mentors: Record<string, MentorDef>;
  domain_mentor_map: Record<string, { primary: string[]; secondary: string[] }>;
  review_passes: Record<string, ReviewPassEntry[]>;
  prompt_injection_template: string;
}

let _mentorsCache: MentorsConfig | null = null;

function loadMentorsConfig(): MentorsConfig | null {
  if (_mentorsCache) return _mentorsCache;
  const mentorsPath = path.join(__dirname, "../config/mentors.yaml");
  if (!fs.existsSync(mentorsPath)) return null;
  try {
    _mentorsCache = yaml.load(
      fs.readFileSync(mentorsPath, "utf-8")
    ) as MentorsConfig;
    return _mentorsCache;
  } catch {
    return null;
  }
}

/**
 * Builds mentor context string for an agent based on its mentors field.
 * Reads the agent's mentors.primary/secondary names, looks them up in
 * config/mentors.yaml, and returns formatted mentor principles.
 */
function buildMentorContext(agent: AgentConfig): string {
  const mentorsConfig = loadMentorsConfig();
  if (!mentorsConfig || !agent.mentors) return "";

  const parts: string[] = ["## Mentor Influences\n"];

  // Helper: convert display name "Steve Jobs" → snake_case key "steve_jobs"
  const toKey = (name: string): string =>
    name.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, "");

  // Primary mentors
  for (const name of agent.mentors.primary || []) {
    const key = toKey(name);
    const mentor = mentorsConfig.mentors[key];
    if (mentor) {
      parts.push(`### ${mentor.name} (Primary Mentor)`);
      parts.push(`> "${mentor.quote}"\n`);
      parts.push(`**Principles to apply:**`);
      for (const p of mentor.principles.slice(0, 3)) {
        parts.push(`- ${p}`);
      }
      parts.push(`\n**Review lens:** ${mentor.review_lens}\n`);
    }
  }

  // Secondary mentors (lighter touch — just quote + lens)
  for (const name of agent.mentors.secondary || []) {
    const key = toKey(name);
    const mentor = mentorsConfig.mentors[key];
    if (mentor) {
      parts.push(`### ${mentor.name} (Secondary Influence)`);
      parts.push(`> "${mentor.quote}"`);
      parts.push(`**Review lens:** ${mentor.review_lens}\n`);
    }
  }

  // Agent's own mentor lens questions
  if (agent.mentor_lens) {
    parts.push(`### Your Mentor Quality Checklist`);
    parts.push(agent.mentor_lens);
  }

  return parts.join("\n");
}

// ─── Phase-to-Review Mapping ──────────────────────────────────────────────────

const PHASE_REVIEW_MAP: Record<number, string> = {
  1: "after_planning",
  2: "after_design",
  5: "after_build",
  7: "after_testing",
  8: "after_deploy",
};

// ─── Utility Agents ───────────────────────────────────────────────────────────

const UTILITY_AGENTS = {
  feedback: "feedback_agent",
  deployment_readiness: "deployment_readiness_agent",
  directory_housekeeping: "directory_housekeeping_agent",
};

// ─── Claude API Client ────────────────────────────────────────────────────────

interface ClaudeMessage {
  role: "user" | "assistant";
  content: string;
}

interface ClaudeResponse {
  content: Array<{ type: string; text: string }>;
  usage: { input_tokens: number; output_tokens: number };
}

async function callClaude(
  systemPrompt: string,
  messages: ClaudeMessage[],
  maxTokens: number = 4096
): Promise<{ text: string; tokens_used: number }> {
  const apiKey = process.env.ANTHROPIC_API_KEY;

  if (!apiKey || apiKey === "sk-ant-...") {
    // Fallback: generate a structured placeholder when no API key
    return {
      text: generatePlaceholderOutput(systemPrompt, messages),
      tokens_used: 0,
    };
  }

  const response = await fetch("https://api.anthropic.com/v1/messages", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "x-api-key": apiKey,
      "anthropic-version": "2023-06-01",
    },
    body: JSON.stringify({
      model: "claude-sonnet-4-20250514",
      max_tokens: maxTokens,
      system: systemPrompt,
      messages,
    }),
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`Claude API error (${response.status}): ${error}`);
  }

  const data = (await response.json()) as ClaudeResponse;
  return {
    text: data.content[0]?.text || "",
    tokens_used: data.usage.input_tokens + data.usage.output_tokens,
  };
}

function generatePlaceholderOutput(
  systemPrompt: string,
  messages: ClaudeMessage[]
): string {
  // Extract agent identity from system prompt
  const roleMatch = systemPrompt.match(/You are (?:a |an |the )?(.+?)\./);
  const role = roleMatch ? roleMatch[1] : "Specialist Agent";
  const userMsg = messages.find((m) => m.role === "user")?.content || "";

  return `# Output from ${role}

> **Note**: This is a placeholder output. Set ANTHROPIC_API_KEY in .env to get real AI-generated results.

## Analysis

Based on the provided context, here are the key deliverables:

### Recommendations
1. Review the project requirements and align with the PRD
2. Implement best practices for the ${role.toLowerCase()} domain
3. Coordinate with dependent agents for seamless integration

### Deliverables
- Primary deliverable document (to be generated with API key)
- Implementation specifications
- Quality checklist

### Next Steps
- Pass this output to downstream agents
- Review and iterate based on feedback

---
*Generated by Vibecoded Orchestrator (placeholder mode)*
`;
}

// ─── Execution Plan Generator ─────────────────────────────────────────────────

/**
 * Generates a sequential execution plan from a project session.
 * Groups agents by phase: planning → design → build → test → deploy
 */
export function generateExecutionPlan(session: ProjectSession): ExecutionPlan {
  const phaseOrder = PHASE_ORDER;

  // Filter out chiefs — they coordinate, they don't produce artifacts
  const specialists = session.active_agents.filter(
    (id) => !["CEO", "CMO", "CTO", "COO"].includes(id.toUpperCase())
  );

  // Sort by phase
  const sorted = [...specialists].sort((a, b) => {
    const phaseA = phaseOrder[a] ?? 5;
    const phaseB = phaseOrder[b] ?? 5;
    return phaseA - phaseB;
  });

  // Group into phases for dependency tracking
  const steps: TaskStep[] = [];
  let prevPhaseIds: string[] = [];

  for (const agentId of sorted) {
    const config = session.agent_configs[agentId];
    const phase = phaseOrder[agentId] ?? 5;
    const stepId = `step-${agentId}`;

    // Find previous phase steps for dependencies
    const dependencies = steps
      .filter((s) => {
        const sPhase = phaseOrder[s.owner_agent] ?? 5;
        return sPhase === phase - 1;
      })
      .map((s) => s.id);

    steps.push({
      id: stepId,
      label: `${config?.title || agentId}: Execute task`,
      owner_agent: agentId,
      status: "pending",
      priority: "medium",
      depends_on: dependencies,
      inputs: {
        from_sections: ["project_profile", "prd"],
        from_artifacts: dependencies.map((d) => d.replace("step-", "artifact-")),
      },
      outputs: {
        artifact_id: `artifact-${agentId}`,
        summary: "",
      },
      token_cap: config?.token_cap || 2000,
    });
  }

  // ─── Inject utility agents ─────────────────────────────────────────────
  // Feedback agent runs after each major phase as a quality gate
  const completedPhases = new Set(sorted.map((id) => phaseOrder[id] ?? 5));
  const phasesForFeedback = [1, 2, 5, 7]; // planning, design, build, testing
  let feedbackCounter = 0;
  for (const phase of phasesForFeedback) {
    if (!completedPhases.has(phase)) continue;
    feedbackCounter++;
    const feedbackStepId = `step-feedback_agent-phase${phase}`;
    const phaseStepIds = steps
      .filter((s) => (phaseOrder[s.owner_agent] ?? 5) === phase)
      .map((s) => s.id);
    if (phaseStepIds.length === 0) continue;

    steps.push({
      id: feedbackStepId,
      label: `Feedback Agent: Quality gate after phase ${phase}`,
      owner_agent: UTILITY_AGENTS.feedback,
      status: "pending",
      priority: "high",
      depends_on: phaseStepIds,
      inputs: {
        from_sections: ["prd"],
        from_artifacts: phaseStepIds.map((d) => d.replace("step-", "artifact-")),
      },
      outputs: {
        artifact_id: `artifact-feedback_agent-phase${phase}`,
        summary: "",
      },
      token_cap: 2000,
    });
  }

  // Directory housekeeping agent runs near the end (after build + testing)
  const allBuildTestStepIds = steps
    .filter((s) => {
      const p = phaseOrder[s.owner_agent] ?? 5;
      return p >= 5 && p <= 7;
    })
    .map((s) => s.id);
  if (allBuildTestStepIds.length > 0) {
    steps.push({
      id: "step-directory_housekeeping_agent",
      label: "Directory Housekeeping: Cleanup temp files and validate structure",
      owner_agent: UTILITY_AGENTS.directory_housekeeping,
      status: "pending",
      priority: "medium",
      depends_on: allBuildTestStepIds,
      inputs: {
        from_sections: ["project_profile"],
        from_artifacts: [],
      },
      outputs: {
        artifact_id: "artifact-directory_housekeeping_agent",
        summary: "",
      },
      token_cap: 2000,
    });
  }

  // Deployment readiness agent is ALWAYS the final step
  const allPriorStepIds = steps.map((s) => s.id);
  steps.push({
    id: "step-deployment_readiness_agent",
    label: "Deployment Readiness: Ensure single-command deployability",
    owner_agent: UTILITY_AGENTS.deployment_readiness,
    status: "pending",
    priority: "high",
    depends_on: allPriorStepIds,
    inputs: {
      from_sections: ["project_profile", "prd"],
      from_artifacts: allPriorStepIds.map((d) => d.replace("step-", "artifact-")),
    },
    outputs: {
      artifact_id: "artifact-deployment_readiness_agent",
      summary: "",
    },
    token_cap: 3000,
  });

  return {
    project_id: session.project_id,
    created_at: new Date().toISOString(),
    steps,
    current_step: 0,
    status: "pending",
  };
}

// ─── Plan Persistence ─────────────────────────────────────────────────────────

function getPlanPath(projectId: string): string {
  return path.join(
    "./config/project-sessions",
    projectId,
    "execution-plan.yaml"
  );
}

export function savePlan(plan: ExecutionPlan): void {
  const planPath = getPlanPath(plan.project_id);
  fs.writeFileSync(planPath, yaml.dump(plan), "utf-8");
}

export function loadPlan(projectId: string): ExecutionPlan | null {
  const planPath = getPlanPath(projectId);
  if (!fs.existsSync(planPath)) return null;
  return yaml.load(fs.readFileSync(planPath, "utf-8")) as ExecutionPlan;
}

// ─── Artifact Storage ─────────────────────────────────────────────────────────

function getArtifactDir(projectId: string): string {
  const dir = path.join("./runs/artifacts", projectId);
  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
  return dir;
}

function saveArtifact(
  projectId: string,
  agentId: string,
  content: string
): ArtifactMeta {
  const dir = getArtifactDir(projectId);
  const filename = `${agentId}-output.md`;
  const filepath = path.join(dir, filename);
  fs.writeFileSync(filepath, content, "utf-8");

  const meta: ArtifactMeta = {
    id: `artifact-${agentId}`,
    agent_id: agentId,
    type: "markdown",
    filename,
    summary: content.split("\n").slice(0, 3).join(" ").substring(0, 150),
    created_at: new Date().toISOString(),
    token_count: Math.ceil(content.length / 4), // rough estimate
  };

  // Append to manifest
  const manifestPath = path.join(dir, "manifest.json");
  let manifest: ArtifactMeta[] = [];
  if (fs.existsSync(manifestPath)) {
    manifest = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));
  }
  manifest = manifest.filter((a) => a.id !== meta.id); // upsert
  manifest.push(meta);
  fs.writeFileSync(manifestPath, JSON.stringify(manifest, null, 2), "utf-8");

  return meta;
}

// ─── Context Builder ──────────────────────────────────────────────────────────

function buildAgentContext(
  session: ProjectSession,
  agent: AgentConfig,
  plan: ExecutionPlan,
  step: TaskStep
): string {
  const parts: string[] = [];

  // 1. PRD excerpt (first 2000 chars to stay within token budget)
  const prdPath = session.prd_path;
  if (fs.existsSync(prdPath)) {
    const prd = fs.readFileSync(prdPath, "utf-8");
    const maxPrdChars = Math.min(prd.length, 3000);
    parts.push(`## Project PRD (excerpt)\n\n${prd.substring(0, maxPrdChars)}\n`);
  }

  // 2. Upstream artifact summaries
  const artifactDir = getArtifactDir(session.project_id);
  for (const depId of step.depends_on) {
    const depStep = plan.steps.find((s) => s.id === depId);
    if (depStep && depStep.outputs.summary) {
      parts.push(
        `## Input from ${depStep.owner_agent}\n\n${depStep.outputs.summary}\n`
      );
    }
    // Also include the actual artifact if small enough
    const depArtifactFile = path.join(
      artifactDir,
      `${depStep?.owner_agent}-output.md`
    );
    if (fs.existsSync(depArtifactFile)) {
      const content = fs.readFileSync(depArtifactFile, "utf-8");
      if (content.length < 2000) {
        parts.push(
          `## Full output from ${depStep?.owner_agent}\n\n${content}\n`
        );
      }
    }
  }

  // 3. Agent's expected inputs/outputs
  parts.push(`## Your Expected Inputs\n${(agent.expected_inputs || []).join(", ")}`);
  parts.push(
    `## Your Expected Outputs\n${(agent.expected_outputs || []).join(", ")}`
  );

  // 4. Persona enrichment (if available)
  const personaDir = path.join(__dirname, "../agents/personas");
  if (fs.existsSync(personaDir)) {
    const personaFiles = fs.readdirSync(personaDir);
    // Try to find a matching persona by agent domain keywords
    const agentKeywords = agent.id.split("_");
    const matchingPersona = personaFiles.find((f) =>
      agentKeywords.some((kw) => f.toLowerCase().includes(kw))
    );
    if (matchingPersona) {
      const personaContent = fs.readFileSync(
        path.join(personaDir, matchingPersona),
        "utf-8"
      );
      // Only include first 1500 chars of persona to save tokens
      parts.push(
        `## Expert Persona Context\n\n${personaContent.substring(0, 1500)}\n`
      );
    }
  }

  // 5. Mentor context injection
  const mentorContext = buildMentorContext(agent);
  if (mentorContext) {
    parts.push(mentorContext);
  }

  return parts.join("\n---\n\n");
}

// ─── Phase Helpers ────────────────────────────────────────────────────────────

const PHASE_ORDER: Record<string, number> = {
  product_manager: 1, marketing_strategist: 1, ux_researcher: 1,
  information_architect: 2, ux_designer: 2, ui_designer: 2, art_director: 2,
  design_systems_engineer: 2, interaction_designer: 2, motion_designer: 2, "3d_designer": 2,
  content_strategist: 3, brand_strategist: 3, seo_specialist: 3,
  marketing_analytics: 3, email_strategist: 3, growth_marketer: 3,
  api_designer: 4, database_engineer: 4, security_engineer: 4,
  web_frontend_engineer: 5, backend_engineer: 5, ios_engineer: 5,
  android_engineer: 5, cross_platform_engineer: 5, design_engineer: 5,
  data_engineer: 5, ml_engineer: 5, webgl_engineer: 5, email_platform_builder: 5,
  editorial_writer: 6, email_copywriter: 6, marketing_copywriter: 6,
  ux_writer: 6, technical_writer: 6, social_media_marketer: 6,
  social_video_creator: 6, video_producer: 6, email_designer: 6, marketing_designer: 6,
  qa_engineer: 7, test_automation_engineer: 7, accessibility_engineer: 7,
  frontend_performance_engineer: 7, product_analyst: 7, experimentation_engineer: 7, cro_specialist: 7,
  devops_engineer: 8, release_engineer: 8, performance_marketer: 8,
  sem_specialist: 8, media_buyer: 8, aso_specialist: 8,
  community_manager: 9, influencer_manager: 9, partnership_manager: 9,
  affiliate_manager: 9, crm_automation_specialist: 9, push_messaging_specialist: 9, prototype_engineer: 9,
  // Utility agents get phases beyond 9
  feedback_agent: 10, directory_housekeeping_agent: 11, deployment_readiness_agent: 12,
};

function getAgentPhase(agentId: string): number {
  return PHASE_ORDER[agentId] ?? 5;
}

// ─── Mentor Review Pass Runner ────────────────────────────────────────────────

/**
 * Runs a mentor review pass after a phase completes.
 * Reads the review_passes from config/mentors.yaml, collects all artifacts
 * from the just-completed phase, and asks Claude to evaluate them through
 * the mentor's lens.
 */
async function runMentorReviewPass(
  projectId: string,
  session: ProjectSession,
  plan: ExecutionPlan,
  reviewKey: string,
  phaseNumber: number
): Promise<{ artifact: ArtifactMeta; tokens: number } | null> {
  const mentorsConfig = loadMentorsConfig();
  if (!mentorsConfig) return null;

  const reviewEntries = mentorsConfig.review_passes?.[reviewKey];
  if (!reviewEntries || reviewEntries.length === 0) return null;

  // Collect artifacts from the completed phase
  const artifactDir = getArtifactDir(projectId);
  const phaseSteps = plan.steps.filter(
    (s) => getAgentPhase(s.owner_agent) === phaseNumber && s.status === "done"
  );

  const phaseArtifactSummaries: string[] = [];
  for (const step of phaseSteps) {
    const artifactFile = path.join(artifactDir, `${step.owner_agent}-output.md`);
    if (fs.existsSync(artifactFile)) {
      const content = fs.readFileSync(artifactFile, "utf-8");
      // Use summary (first 500 chars) to stay within token budget
      phaseArtifactSummaries.push(
        `### ${step.owner_agent}\n${content.substring(0, 500)}\n`
      );
    }
  }

  if (phaseArtifactSummaries.length === 0) return null;

  // Build the mentor review prompt
  const mentorQuestions = reviewEntries
    .map((entry) => {
      const mentor = mentorsConfig.mentors[entry.mentor];
      const mentorName = mentor?.name || entry.mentor;
      return `**${mentorName}** (${entry.focus}):\n> "${mentor?.quote || ""}"\n- ${entry.question}`;
    })
    .join("\n\n");

  const systemPrompt = `You are a quality review panel composed of world-class mentors.
Your job is to evaluate the outputs from Phase ${phaseNumber} of a project pipeline
and provide constructive feedback through the lens of each mentor.

Be specific, actionable, and concise. For each mentor perspective:
1. Score the output (A/B/C/D/F)
2. Highlight what's done well
3. Flag what needs improvement
4. Provide 1-2 specific actionable suggestions

End with an overall PASS / PASS_WITH_NOTES / NEEDS_REVISION verdict.`;

  const userMessage = `## Project: ${session.project_name}

## Mentor Review Panel (${reviewKey})

${mentorQuestions}

## Phase ${phaseNumber} Artifacts to Review

${phaseArtifactSummaries.join("\n---\n\n")}

Please provide your mentor review panel assessment.`;

  try {
    const result = await callClaude(
      systemPrompt,
      [{ role: "user", content: userMessage }],
      2048
    );

    const artifact = saveArtifact(
      projectId,
      `mentor-review-${reviewKey}`,
      result.text
    );

    return { artifact, tokens: result.tokens_used };
  } catch (error) {
    console.error(`  ⚠ Mentor review pass (${reviewKey}) failed: ${(error as Error).message}`);
    return null;
  }
}

// ─── Execution Engine ─────────────────────────────────────────────────────────

export type ProgressCallback = (
  step: TaskStep,
  total: number,
  index: number
) => void;

/**
 * Executes an entire project session — runs each agent in phase order,
 * passing context and collecting artifacts.
 */
export async function executeProject(
  projectId: string,
  onProgress?: ProgressCallback
): Promise<ExecutionResult> {
  const startTime = Date.now();

  // Load session
  const sessionPath = path.join(
    "./config/project-sessions",
    projectId,
    "session.yaml"
  );
  if (!fs.existsSync(sessionPath)) {
    throw new Error(`Session not found: ${projectId}`);
  }
  const session = yaml.load(
    fs.readFileSync(sessionPath, "utf-8")
  ) as ProjectSession;

  // Generate or load execution plan
  let plan = loadPlan(projectId);
  if (!plan) {
    plan = generateExecutionPlan(session);
    savePlan(plan);
  }

  // Update status
  plan.status = "running";
  updateSessionStatus(projectId, "running");
  savePlan(plan);

  const artifacts: ArtifactMeta[] = [];
  let totalTokens = 0;

  // Execute each step
  for (let i = 0; i < plan.steps.length; i++) {
    const step = plan.steps[i];

    // Skip completed steps (for resume support)
    if (step.status === "done" || step.status === "skipped") continue;

    // Check dependencies
    const depsCompleted = step.depends_on.every((depId) => {
      const dep = plan!.steps.find((s) => s.id === depId);
      return dep && (dep.status === "done" || dep.status === "skipped");
    });

    if (!depsCompleted) {
      step.status = "skipped";
      step.error = "Dependencies not met";
      savePlan(plan);
      continue;
    }

    // Load full agent config
    const agent = loadAgentFromPool(step.owner_agent);
    if (!agent) {
      step.status = "skipped";
      step.error = `Agent not found: ${step.owner_agent}`;
      savePlan(plan);
      continue;
    }

    // Update progress
    step.status = "in_progress";
    step.started_at = new Date().toISOString();
    plan.current_step = i;
    savePlan(plan);

    if (onProgress) onProgress(step, plan.steps.length, i);

    try {
      // Build context for this agent
      const context = buildAgentContext(session, agent, plan, step);

      // Call Claude with agent's system prompt
      const result = await callClaude(
        agent.system_prompt,
        [
          {
            role: "user",
            content: `You are working on project "${session.project_name}".

Here is the context you need:

${context}

Please produce your deliverables as specified in your expected outputs. Be thorough but concise (max ~${step.token_cap} tokens). Structure your output with clear headers.`,
          },
        ],
        Math.min(step.token_cap * 2, 4096)
      );

      // Save artifact
      const artifact = saveArtifact(projectId, step.owner_agent, result.text);
      artifacts.push(artifact);
      totalTokens += result.tokens_used;

      // Update step
      step.status = "done";
      step.completed_at = new Date().toISOString();
      step.outputs.summary =
        result.text.split("\n").slice(0, 5).join(" ").substring(0, 200);
      step.outputs.artifact_id = artifact.id;
      savePlan(plan);

      // ─── Mentor Review Pass (after phase milestones) ────────────────────
      const agentPhase = getAgentPhase(step.owner_agent);
      const isLastInPhase = !plan.steps.some(
        (s) =>
          s.id !== step.id &&
          getAgentPhase(s.owner_agent) === agentPhase &&
          s.status === "pending"
      );

      if (isLastInPhase && PHASE_REVIEW_MAP[agentPhase]) {
        const reviewKey = PHASE_REVIEW_MAP[agentPhase];
        const mentorReviewResult = await runMentorReviewPass(
          projectId,
          session,
          plan,
          reviewKey,
          agentPhase
        );
        if (mentorReviewResult) {
          artifacts.push(mentorReviewResult.artifact);
          totalTokens += mentorReviewResult.tokens;
          console.log(
            `  🧠 Mentor review pass (${reviewKey}) completed`
          );
        }
      }
    } catch (error) {
      step.status = "failed";
      step.error = (error as Error).message;
      step.completed_at = new Date().toISOString();
      savePlan(plan);

      // Continue to next step — don't block the whole pipeline
      console.error(
        `  ⚠ Agent ${step.owner_agent} failed: ${step.error}`
      );
    }
  }

  // Finalize
  const allDone = plan.steps.every(
    (s) => s.status === "done" || s.status === "skipped"
  );
  plan.status = allDone ? "completed" : "failed";
  savePlan(plan);
  updateSessionStatus(projectId, allDone ? "complete" : "failed");

  return {
    plan,
    artifacts,
    total_tokens_used: totalTokens,
    duration_ms: Date.now() - startTime,
  };
}

// ─── Utility: List Sessions ───────────────────────────────────────────────────

export function listSessions(): Array<{
  project_id: string;
  project_name: string;
  status: string;
  created_at: string;
  agent_count: number;
}> {
  const sessionsDir = "./config/project-sessions";
  if (!fs.existsSync(sessionsDir)) return [];

  const dirs = fs
    .readdirSync(sessionsDir)
    .filter((d) =>
      fs.statSync(path.join(sessionsDir, d)).isDirectory()
    );

  return dirs
    .map((d) => {
      const sessionPath = path.join(sessionsDir, d, "session.yaml");
      if (!fs.existsSync(sessionPath)) return null;
      const session = yaml.load(
        fs.readFileSync(sessionPath, "utf-8")
      ) as ProjectSession;
      return {
        project_id: session.project_id,
        project_name: session.project_name,
        status: session.status,
        created_at: session.created_at,
        agent_count: session.active_agents.length,
      };
    })
    .filter(Boolean) as any[];
}

/**
 * Get full details for a session including plan and artifacts.
 */
export function getSessionDetails(projectId: string): {
  session: ProjectSession;
  plan: ExecutionPlan | null;
  artifacts: ArtifactMeta[];
} | null {
  const sessionPath = path.join(
    "./config/project-sessions",
    projectId,
    "session.yaml"
  );
  if (!fs.existsSync(sessionPath)) return null;

  const session = yaml.load(
    fs.readFileSync(sessionPath, "utf-8")
  ) as ProjectSession;
  const plan = loadPlan(projectId);

  const manifestPath = path.join(
    "./runs/artifacts",
    projectId,
    "manifest.json"
  );
  let artifacts: ArtifactMeta[] = [];
  if (fs.existsSync(manifestPath)) {
    artifacts = JSON.parse(fs.readFileSync(manifestPath, "utf-8"));
  }

  return { session, plan, artifacts };
}
