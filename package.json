{
  "name": "vibecoded-orchestrator",
  "version": "2.0.0",
  "description": "Multi-agent orchestrator with TaskFlow web app — 74 specialist agents, 30 mentors (ancient to modern), 81 personas, 44 MCP tools, 14 quality-gate skills, 35+ PRD templates, 495-param CTO evaluation, cross-tool compatibility (7+ AI tools), auto-update from upstream registries, multi-model support (Anthropic/OpenAI/Gemini/Bedrock)",
  "private": false,
  "scripts": {
    "dev": "next dev -p 1000",
    "build": "next build",
    "start:web": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:md": "markdownlint-cli2 '**/*.md' '#node_modules' '#.next' '#runs'",
    "lint:all": "npm run lint && npm run lint:md",
    "type-check": "tsc --noEmit",
    "orchestrator": "ts-node --project tsconfig.orchestrator.json orchestrator/index.ts",
    "orchestrator:execute": "ts-node --project tsconfig.orchestrator.json orchestrator/index.ts execute",
    "orchestrator:list": "ts-node --project tsconfig.orchestrator.json orchestrator/index.ts list",
    "orchestrator:watch": "ts-node --project tsconfig.orchestrator.json --watch orchestrator/index.ts",
    "list-agents": "node scripts/list-agents.js",
    "validate": "ts-node --project tsconfig.orchestrator.json scripts/validate-agents.ts",
    "check:loc": "ts-node --project tsconfig.orchestrator.json scripts/check-ts-max-loc.ts",
    "commit": "bash scripts/committer",
    "bench:model": "ts-node --project tsconfig.orchestrator.json scripts/bench-model.ts",
    "usage:report": "ts-node --project tsconfig.orchestrator.json scripts/usage-report.ts",
    "check:llm": "ts-node --project tsconfig.orchestrator.json scripts/check-local-llm.ts",
    "sync:labels": "ts-node --project tsconfig.orchestrator.json scripts/sync-labels.ts",
    "queue": "ts-node --project tsconfig.orchestrator.json scripts/queue-manager.ts",
    "pr:create": "bash scripts/pr create",
    "release:check": "ts-node --project tsconfig.orchestrator.json scripts/release-check.ts",
    "generate:master-prd": "tsx scripts/generate-master-prd.ts",
    "generate:all-prds": "tsx scripts/generate-all-prds.ts",
    "setup:project": "tsx scripts/setup-project.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:orchestrator": "vitest run orchestrator/",
    "playwright": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "install:clean": "rm -rf node_modules package-lock.json && npm cache clean --force && npm install",
    "mcp:build": "cd mcp-server && npm run build",
    "mcp:dev": "cd mcp-server && npm run dev",
    "mcp:install": "cd mcp-server && npm install",
    "setup": "bash start.sh --setup",
    "setup:check": "bash start.sh --check",
    "setup:clean": "bash start.sh --clean",
    "evaluate": "bash tools/cto-evaluation/evaluate",
    "evaluate:quick": "bash tools/cto-evaluation/evaluate . --quick",
    "improve": "npx ts-node --project tsconfig.orchestrator.json orchestrator/cil-cli.ts",
    "improve:list": "npx ts-node --project tsconfig.orchestrator.json orchestrator/cil-cli.ts list",
    "prepare": "husky install",
    "convert": "bash scripts/convert.sh",
    "convert:cursor": "bash scripts/convert.sh --format cursor",
    "convert:gemini": "bash scripts/convert.sh --format gemini-cli",
    "install:tools": "bash scripts/install.sh",
    "lint:agents": "bash scripts/lint-agents.sh",
    "lint:skills": "bash scripts/validate-skills.sh",
    "sync:upstream": "bash scripts/sync-upstream.sh",
    "update": "bash scripts/update.sh",
    "update:check": "bash scripts/update.sh --check",
    "update:sync": "bash scripts/update.sh --sync-only"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@hookform/resolvers": "^3.3.4",
    "@next/bundle-analyzer": "^15.5.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-hover-card": "^1.0.7",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.0.3",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tanstack/react-query": "^5.17.19",
    "@tanstack/react-table": "^8.11.8",
    "bcryptjs": "^3.0.2",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.0",
    "commander": "^11.1.0",
    "date-fns": "^3.3.1",
    "es-abstract": "^1.24.0",
    "framer-motion": "^10.18.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.312.0",
    "next": "^15.5.0",
    "next-auth": "5.0.0-beta.25",
    "next-themes": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.49.3",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.10.4",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^18.4.4",
    "@playwright/test": "^1.41.1",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/addon-onboarding": "^10.5.5",
    "@storybook/blocks": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.17",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.0.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-storybook": "^0.6.15",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "markdownlint-cli2": "^0.12.1",
    "msw": "^2.1.5",
    "postcss": "^8.4.33",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "prisma": "^5.22.0",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
